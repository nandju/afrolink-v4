# ─────────────────────────────────────────────────────────────
# AfroLink — Variables d'environnement EmailJS
# Copiez ce fichier en .env.local et renseignez les valeurs.
# Ne committez JAMAIS .env.local — il est déjà ignoré par git.
#
# Ces variables sont volontairement publiques (NEXT_PUBLIC_) :
# l'envoi se fait depuis le navigateur via @emailjs/browser.
# La public key EmailJS est conçue pour être exposée ; le
# destinataire de la notification équipe est fixé dans le
# template EmailJS — le navigateur ne peut pas le modifier.
# ─────────────────────────────────────────────────────────────

# ID du service EmailJS (Email Services → votre service → Service ID)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=

# Clé publique EmailJS (Account → General → Public Key)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Template de notification envoyé à l'équipe AfroLink.
# Le destinataire (afrolinkci@gmail.com) est fixé dans le template
# côté dashboard EmailJS — le navigateur ne peut pas le modifier.
# (Email Templates → template équipe → Template ID)
NEXT_PUBLIC_EMAILJS_TEAM_TEMPLATE_ID=
